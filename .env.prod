# ========================================
# CONFIGURACIÓN DE ENTORNO - PRODUCCIÓN
# ========================================
# Entorno: Production
# Propósito: Despliegue en producción
# ⚠️ IMPORTANTE: NUNCA subir este archivo con valores reales al repositorio

# ========================================
# BASE DE DATOS
# ========================================
DB_HOST=db.mkcqotbnmkapcydotrwx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=J2j8xu1eiHhkvq

# ========================================
# SEGURIDAD Y JWT
# ========================================
# ⚠️ CRÍTICO: Usar claves fuertes y únicas en producción
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_KEY_MIN_64_CHARS
JWT_EXPIRATION_MS=3600000

# Usuario admin (deshabilitado en producción)
ADMIN_USERNAME=disabled
ADMIN_PASSWORD=disabled

# ========================================
# EMAIL (SMTP) - Producción
# ========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@clipperbarber.com
MAIL_PASSWORD=your-production-app-password

# ========================================
# APLICACIÓN
# ========================================
APP_BASE_URL=https://api.clipperbarber.com
APP_FRONTEND_URL=https://clipperbarber.com

# Verificación de Email
VERIFICATION_USE_CODE=true
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_EXPIRY_MINUTES=15

# ========================================
# SUPABASE STORAGE - Producción
# ========================================
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_API_KEY=your-production-service-role-key
SUPABASE_BUCKET_EMPRESAS=clipper-images
SUPABASE_BUCKET_SERVICIOS=Barber-Services

# ========================================
# HIBERNATE - Producción
# ========================================
# ⚠️ IMPORTANTE: NUNCA usar 'create' o 'create-drop' en producción
HIBERNATE_DDL_AUTO=validate
HIBERNATE_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false

# ========================================
# LOGGING - Producción (menos verbose)
# ========================================
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=WARN

# ========================================
# NOTAS DE SEGURIDAD PARA PRODUCCIÓN
# ========================================
# 1. Cambiar TODAS las contraseñas y secrets
# 2. JWT_SECRET debe ser aleatorio, mínimo 64 caracteres
# 3. Usar HTTPS en todas las URLs
# 4. Hibernate DDL debe ser 'validate' o 'none'
# 5. Deshabilitar usuario admin por defecto
# 6. Logs en nivel WARN o INFO (no DEBUG)
# 7. Usar variables de entorno del sistema o secrets manager
# 8. Configurar SSL/TLS para la base de datos
# 9. Activar CORS solo para dominios específicos
# 10. Implementar rate limiting y protección DDoS
